digraph UML {
graph [rankdir=BT, splines=ortho, nodesep=0.55, ranksep=0.75, bgcolor="white", pad=0.4, fontname="Helvetica"];
node [shape=plaintext, fontname="Helvetica", fontsize=15];
edge [fontname="Helvetica", fontsize=13, color="#222222", penwidth=1.3];
Iterable [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#222222"><TR><TD BGCOLOR="#F5C542" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;Interface&gt;&gt;</FONT><BR/><B>Iterable</B></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">+iterator() : Iterator&lt;T&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Exception [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#222222"><TR><TD BGCOLOR="#F5C542" ALIGN="CENTER"><B>Exception</B></TD></TR><TR><TD BGCOLOR="#F5C542" HEIGHT="14"> </TD></TR></TABLE>>];
Comparator [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#222222"><TR><TD BGCOLOR="#F5C542" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;Interface&gt;&gt;</FONT><BR/><B>Comparator</B></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">+compare(o1 : T, o2 : T) : int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Iterator [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#222222"><TR><TD BGCOLOR="#F5C542" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;Interface&gt;&gt;</FONT><BR/><B>Iterator</B></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">+hasNext() : boolean<BR ALIGN="LEFT"/>+next() : T<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
PlayList [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#222222"><TR><TD BGCOLOR="#F5C542" ALIGN="CENTER"><B>PlayList</B></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">-list : LinkedList&lt;AudioFile&gt;<BR ALIGN="LEFT"/>-search : String<BR ALIGN="LEFT"/>-sortCriterion : SortCriterion<BR ALIGN="LEFT"/>-currentFile : AudioFile<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">+PlayList()<BR ALIGN="LEFT"/>+PlayList(m3uPathname : String)<BR ALIGN="LEFT"/>+add(file : AudioFile)<BR ALIGN="LEFT"/>+remove(file : AudioFile)<BR ALIGN="LEFT"/>+size() : int<BR ALIGN="LEFT"/>+currentAudioFile() : AudioFile<BR ALIGN="LEFT"/>+nextSong() : void<BR ALIGN="LEFT"/>+loadFromM3U(pathname : String) : void<BR ALIGN="LEFT"/>+saveAsM3U(pathname : String) : void<BR ALIGN="LEFT"/>+getList() : List&lt;AudioFile&gt;<BR ALIGN="LEFT"/>+getSortCriterion() : SortCriterion<BR ALIGN="LEFT"/>+setSortCriterion(value : SortCriterion)<BR ALIGN="LEFT"/>+getSearch() : String<BR ALIGN="LEFT"/>+setSearch(value : String)<BR ALIGN="LEFT"/>+iterator() : Iterator&lt;AudioFile&gt;<BR ALIGN="LEFT"/>+jumpToAudioFile(file : AudioFile)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
NotPlayableException [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#222222"><TR><TD BGCOLOR="#F5C542" ALIGN="CENTER"><B>NotPlayableException</B></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">-pathname : String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">+NotPlayableException(pathname : String, msg : String)<BR ALIGN="LEFT"/>+NotPlayableException(pathname : String, t : Throwable)<BR ALIGN="LEFT"/>+NotPlayableException(pathname : String, msg : String, t : Throwable)<BR ALIGN="LEFT"/>+getPathname() : String<BR ALIGN="LEFT"/>+toString() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
AuthorComparator [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#222222"><TR><TD BGCOLOR="#F5C542" ALIGN="CENTER"><B>AuthorComparator</B></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">+compare(o1 : AudioFile, o2 : AudioFile) : int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
TitleComparator [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#222222"><TR><TD BGCOLOR="#F5C542" ALIGN="CENTER"><B>TitleComparator</B></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">+compare(o1 : AudioFile, o2 : AudioFile) : int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
AlbumComparator [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#222222"><TR><TD BGCOLOR="#F5C542" ALIGN="CENTER"><B>AlbumComparator</B></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">+compare(o1 : AudioFile, o2 : AudioFile) : int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
DurationComparator [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#222222"><TR><TD BGCOLOR="#F5C542" ALIGN="CENTER"><B>DurationComparator</B></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">+compare(o1 : AudioFile, o2 : AudioFile) : int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
SortCriterion [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#222222"><TR><TD BGCOLOR="#F5C542" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;enumeration&gt;&gt;</FONT><BR/><B>SortCriterion</B></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">DEFAULT<BR ALIGN="LEFT"/>AUTHOR<BR ALIGN="LEFT"/>TITLE<BR ALIGN="LEFT"/>ALBUM<BR ALIGN="LEFT"/>DURATION<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
AudioFileFactory [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#222222"><TR><TD BGCOLOR="#F5C542" ALIGN="CENTER"><B>AudioFileFactory</B></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">+createAudioFile(path : String) : AudioFile  {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ControllablePlayListIterator [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#222222"><TR><TD BGCOLOR="#F5C542" ALIGN="CENTER"><B>ControllablePlayListIterator</B></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">-list : List&lt;AudioFile&gt;<BR ALIGN="LEFT"/>-index : int<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">+ControllablePlayListIterator(list : List&lt;AudioFile&gt;)<BR ALIGN="LEFT"/>+ControllablePlayListIterator(list : List&lt;AudioFile&gt;, search : String, sort : SortCriterion)<BR ALIGN="LEFT"/>+hasNext() : boolean<BR ALIGN="LEFT"/>+next() : AudioFile<BR ALIGN="LEFT"/>+jumpToAudioFile(file : AudioFile) : AudioFile<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
AudioFile [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#222222"><TR><TD BGCOLOR="#F5C542" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;abstract&gt;&gt;</FONT><BR/><B>AudioFile</B></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">-pathname : String<BR ALIGN="LEFT"/>-filename : String<BR ALIGN="LEFT"/>#author : String<BR ALIGN="LEFT"/>#title : String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">+AudioFile(path : String)<BR ALIGN="LEFT"/>+parsePathname(path : String) : void<BR ALIGN="LEFT"/>+parseFilename(file : String) : void<BR ALIGN="LEFT"/>+getPathname() : String<BR ALIGN="LEFT"/>+getFilename() : String<BR ALIGN="LEFT"/>+getAuthor() : String<BR ALIGN="LEFT"/>+getTitle() : String<BR ALIGN="LEFT"/>+toString() : String<BR ALIGN="LEFT"/>+play() : void  {abstract}<BR ALIGN="LEFT"/>+togglePause() : void  {abstract}<BR ALIGN="LEFT"/>+stop() : void  {abstract}<BR ALIGN="LEFT"/>+formatDuration() : String  {abstract}<BR ALIGN="LEFT"/>+formatPosition() : String  {abstract}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
SampledFile [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#222222"><TR><TD BGCOLOR="#F5C542" ALIGN="CENTER"><FONT POINT-SIZE="13">&lt;&lt;abstract&gt;&gt;</FONT><BR/><B>SampledFile</B></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">#duration : long<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">+play() : void<BR ALIGN="LEFT"/>+togglePause() : void<BR ALIGN="LEFT"/>+stop() : void<BR ALIGN="LEFT"/>+formatDuration() : String<BR ALIGN="LEFT"/>+formatPosition() : String<BR ALIGN="LEFT"/>+timeFormatter(micros : long) : String  {static}<BR ALIGN="LEFT"/>+getDuration() : long<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
TaggedFile [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#222222"><TR><TD BGCOLOR="#F5C542" ALIGN="CENTER"><B>TaggedFile</B></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">-album : String<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">+TaggedFile(path : String)<BR ALIGN="LEFT"/>+getAlbum() : String<BR ALIGN="LEFT"/>+readAndStoreTags() : void<BR ALIGN="LEFT"/>+toString() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
WavFile [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#222222"><TR><TD BGCOLOR="#F5C542" ALIGN="CENTER"><B>WavFile</B></TD></TR><TR><TD BGCOLOR="#F5C542" ALIGN="LEFT" BALIGN="LEFT">+WavFile(path : String)<BR ALIGN="LEFT"/>+readAndSetDurationFromFile() : void<BR ALIGN="LEFT"/>+computeDuration(frames : long, rate : float) : long  {static}<BR ALIGN="LEFT"/>+toString() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
PlayList -> Iterable [style=dashed, arrowhead=empty, arrowsize=1.4, color="#1d6fb8"];
ControllablePlayListIterator -> Iterator [style=dashed, arrowhead=empty, arrowsize=1.4, color="#1d6fb8", constraint=false];
NotPlayableException -> Exception [arrowhead=empty, arrowsize=1.4];
AuthorComparator -> Comparator [style=dashed, arrowhead=empty, arrowsize=1.4, color="#1d6fb8"];
TitleComparator -> Comparator [style=dashed, arrowhead=empty, arrowsize=1.4, color="#1d6fb8"];
AlbumComparator -> Comparator [style=dashed, arrowhead=empty, arrowsize=1.4, color="#1d6fb8"];
DurationComparator -> Comparator [style=dashed, arrowhead=empty, arrowsize=1.4, color="#1d6fb8"];
SampledFile -> AudioFile [arrowhead=empty, arrowsize=1.4];
TaggedFile -> SampledFile [arrowhead=empty, arrowsize=1.4];
WavFile -> SampledFile [arrowhead=empty, arrowsize=1.4];
AudioFileFactory -> NotPlayableException [style=dashed, arrowhead=vee, arrowsize=1.1, xlabel="  «use»\n  thrown if file\n  extension not known  "];
AudioFile -> NotPlayableException [style=dashed, arrowhead=vee, arrowsize=1.1, xlabel="  «use»\n  thrown if file\n  is not readable  "];
PlayList -> SortCriterion [arrowhead=none, constraint=false];
PlayList -> AudioFile [arrowhead=none, arrowtail=odiamond, dir=back, taillabel="1", headlabel="*", constraint=false];
ControllablePlayListIterator -> Comparator [style=dashed, arrowhead=vee, arrowsize=1.1, xlabel=" sorts with "];
PlayList -> ControllablePlayListIterator [style=dashed, arrowhead=vee, arrowsize=1.1, xlabel=" creates ", constraint=false];
AudioFileFactory -> AudioFile [style=dashed, arrowhead=vee, arrowsize=1.1, xlabel=" creates ", constraint=false];
TitleComparator -> AuthorComparator [style=invis];
AlbumComparator -> TitleComparator [style=invis];
DurationComparator -> AlbumComparator [style=invis];
AudioFile -> DurationComparator [style=invis];
SortCriterion -> NotPlayableException [style=invis];
AudioFileFactory -> PlayList [style=invis];
ControllablePlayListIterator -> AudioFileFactory [style=invis];
Iterator -> ControllablePlayListIterator [style=invis, constraint=false];
{rank=same; Iterable; Exception; Comparator;}
{rank=same; PlayList; NotPlayableException; AuthorComparator;}
{rank=same; AudioFileFactory; AudioFile;}
{rank=same; ControllablePlayListIterator; Iterator; SampledFile;}
}