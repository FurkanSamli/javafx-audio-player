classDiagram
    direction TB

    class Iterable~T~ {
        <<interface>>
        +iterator() Iterator~T~
    }
    class Iterator~T~ {
        <<interface>>
        +hasNext() boolean
        +next() T
    }
    class Comparator~T~ {
        <<interface>>
        +compare(o1: T, o2: T) int
    }
    class Exception

    class PlayList {
        +PlayList()
        +PlayList(m3uPathname: String)
        +add(file: AudioFile)
        +remove(file: AudioFile)
        +size() int
        +currentAudioFile() AudioFile
        +nextSong() void
        +jumpToAudioFile(file: AudioFile)
        +loadFromM3U(pathname: String) void
        +saveAsM3U(pathname: String) void
        +getList() List~AudioFile~
        +getSortCriterion() SortCriterion
        +setSortCriterion(value: SortCriterion)
        +getSearch() String
        +setSearch(value: String)
        +iterator() Iterator~AudioFile~
    }
    class ControllablePlayListIterator {
        -list: List~AudioFile~
        -index: int
        +jumpToAudioFile(file: AudioFile) AudioFile
    }
    class SortCriterion {
        <<enumeration>>
        DEFAULT
        AUTHOR
        TITLE
        ALBUM
        DURATION
    }
    class NotPlayableException {
        -pathname: String
        +NotPlayableException(pathname, msg)
        +NotPlayableException(pathname, t: Throwable)
        +NotPlayableException(pathname, msg, t: Throwable)
        +getPathname() String
        +toString() String
    }
    class AudioFileFactory {
        +createAudioFile(path: String)$ AudioFile
    }
    class AudioFile {
        <<abstract>>
        +parsePathname(path: String)
        +parseFilename(file: String)
        +getAuthor() String
        +getTitle() String
        +play()* void
        +togglePause()* void
        +stop()* void
    }
    class SampledFile {
        <<abstract>>
        #duration: long
        +formatDuration() String
        +formatPosition() String
        +timeFormatter(micros: long)$ String
    }
    class TaggedFile {
        -album: String
        +readAndStoreTags()
    }
    class WavFile {
        +readAndSetDurationFromFile()
        +computeDuration(frames: long, rate: float)$ long
    }
    class AuthorComparator
    class TitleComparator
    class AlbumComparator
    class DurationComparator


    Iterable~T~ <|.. PlayList
    Iterator~T~ <|.. ControllablePlayListIterator
    Exception <|-- NotPlayableException
    Comparator~T~ <|.. AuthorComparator
    Comparator~T~ <|.. TitleComparator
    Comparator~T~ <|.. AlbumComparator
    Comparator~T~ <|.. DurationComparator
    AudioFile <|-- SampledFile
    SampledFile <|-- TaggedFile
    SampledFile <|-- WavFile

    PlayList "1" o-- "*" AudioFile : contains
    PlayList --> SortCriterion
    PlayList ..> ControllablePlayListIterator : creates
    ControllablePlayListIterator ..> Comparator~T~ : sorts with
    AudioFileFactory ..> AudioFile : creates
    AudioFileFactory ..> NotPlayableException : unknown extension
    AudioFile ..> NotPlayableException : file not readable

